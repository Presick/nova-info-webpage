---
import Base from './Base.astro';
import CtaBand from '../components/CtaBand.astro';
import CountyChart from '../components/CountyChart.astro';
import { summary, tradeNaics } from '../lib/cbp';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'guides'>;
  related: CollectionEntry<'guides'>[];
}

const { entry, related } = Astro.props;
const d = entry.data;
const path = d.slug.startsWith('/') ? d.slug : `/${d.slug}`;
const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const trade = d.trade && tradeNaics[d.trade] ? d.trade : undefined;
const s = trade ? summary(trade) : undefined;
const base = Astro.site ?? new URL('https://example.com');
const org = {
  '@type': 'Organization',
  name: 'Nova Impact Solutions',
  url: 'https://novaimpactsolutions.com',
};
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    dateModified: d.last_updated.toISOString().slice(0, 10),
    author: org,
    publisher: org,
    mainEntityOfPage: new URL(path, base).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', base).toString() },
      { '@type': 'ListItem', position: 2, name: d.title, item: new URL(path, base).toString() },
    ],
  },
];
---

<Base title={d.title} description={d.description} path={path} jsonLd={jsonLd}>
  <div class="container article-wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span>{trade ? tradeNaics[trade].short : d.type === 'state' ? 'Kentucky' : 'Research'}</span></nav>

    <header class="article-head">
      <p class="byline">{d.owner_disclosure} <a href="/about">How we handle numbers</a></p>
      <h1>{d.title}</h1>
      <p class="desc">{d.description}</p>
      {d.authorities && d.authorities.length > 0 && (
        <p class="authorities"><span>Built from</span>{d.authorities.map((a) => <a href={a.url} rel="noopener">{a.name}</a>)}</p>
      )}
      <p class="head-cta"><a class="btn" href={`https://30-day.novaimpactsolutions.com/?utm_source=nova-site&utm_medium=guide-top&utm_content=${d.slug.replace(/^\//, '').replace(/\//g, '-')}`} rel="noopener">Try NOVA free for 30 days</a><span>No credit card. Keep your number.</span></p>
      <p class="stamp">
        <span>Updated {fmt(d.last_updated)}</span>
        {d.data_pulled && <span>Census data pulled {fmt(d.data_pulled)}</span>}
      </p>
    </header>

    {s && trade && (
      <section class="glance" aria-label="At a glance">
        <div class="stats">
          <div class="stat"><b>{s.total.toLocaleString('en-US')}</b><span>{tradeNaics[trade].short} establishments with paid employees</span></div>
          <div class="stat"><b>{s.countiesReported}</b><span>Kentucky counties with a reported count</span></div>
          <div class="stat"><b>{s.top.county}</b><span>largest county, {s.top.establishments} establishments</span></div>
        </div>
        <div class="panel"><CountyChart trade={trade} /></div>
      </section>
    )}

    <article class="prose">
      <slot />
    </article>

    <CtaBand where={d.slug.replace(/^\//, '').replace(/\//g, '-')} />

    {related.length > 0 && (
      <nav class="related" aria-label="Related guides">
        <h2>Related guides</h2>
        <ul>
          {related.map((r) => <li><a href={r.data.slug}>{r.data.title}</a></li>)}
        </ul>
      </nav>
    )}
  </div>
</Base>
