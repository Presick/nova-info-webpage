---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description, path, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://example.com').toString();
const fullTitle = path === '/' ? title : `${title} | Missed-Call Guides`;
const trial = 'https://30-day.novaimpactsolutions.com/';
const nav = [
  { href: '/guides/missed-calls-research', label: 'Research' },
  { href: '/kentucky/plumbing-hvac/missed-calls', label: 'Plumbing & HVAC' },
  { href: '/kentucky/electrical/missed-calls', label: 'Electrical' },
  { href: '/kentucky/landscaping-tree/missed-calls', label: 'Landscaping & tree' },
  { href: '/kentucky/roofing/missed-calls', label: 'Roofing' },
  { href: '/guides/ai-receptionist-vs-answering-service', label: 'Compare options' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f2740" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Missed-Call Guides" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/">
          <span class="mark" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
          </span>
          <span>Missed-Call Guides<small>from Nova Impact Solutions</small></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          <span>Menu</span>
        </button>
        <nav class="nav" id="site-nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a>)}
          <a class="btn ghost small" href={`${trial}?utm_source=missed-call-guides&utm_medium=nav`} rel="noopener">NOVA free trial</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <script is:inline>
      (function () {
        var header = document.querySelector('.site-header');
        var btn = header && header.querySelector('.menu-toggle');
        if (!btn) return;
        function set(open) {
          header.toggleAttribute('data-open', open);
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        btn.addEventListener('click', function () { set(!header.hasAttribute('data-open')); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && header.hasAttribute('data-open')) { set(false); btn.focus(); }
        });
        document.addEventListener('click', function (e) {
          if (header.hasAttribute('data-open') && !header.contains(e.target)) set(false);
        });
        window.matchMedia('(min-width: 1101px)').addEventListener('change', function (m) { if (m.matches) set(false); });
      })();
    </script>

    <footer class="site-footer">
      <div class="cols">
        <div>
          <h2>About this site</h2>
          <p>Missed-Call Guides is published by Nova Impact Solutions, which sells NOVA, a 24/7 AI receptionist. We say so on every page, and we label which numbers come from vendors.</p>
          <p><a href="/about">How we handle numbers</a></p>
        </div>
        <div>
          <h2>Guides</h2>
          <ul>
            <li><a href="/guides/missed-calls-research">What the missed-call studies say</a></li>
            <li><a href="/plumbing/after-hours-emergency-calls">Plumbers: after-hours emergency calls</a></li>
            <li><a href="/hvac/peak-season-missed-calls">HVAC: peak-season missed calls</a></li>
            <li><a href="/guides/speed-to-lead-contractors">Speed to lead for contractors</a></li>
            <li><a href="/guides/ai-receptionist-vs-answering-service">AI receptionist vs answering service</a></li>
            <li><a href="/kentucky/plumbing-hvac/missed-calls">Kentucky plumbing &amp; HVAC</a></li>
            <li><a href="/kentucky/electrical/missed-calls">Kentucky electrical</a></li>
            <li><a href="/kentucky/landscaping-tree/missed-calls">Kentucky landscaping &amp; tree</a></li>
            <li><a href="/kentucky/roofing/missed-calls">Kentucky roofing</a></li>
            <li><a href="/kentucky/call-rules">Kentucky call rules</a></li>
          </ul>
        </div>
        <div>
          <h2>Nova Impact Solutions</h2>
          <p>7659 Mall Road<br />Florence, KY 41042<br /><a href="tel:+18595947440">(859) 594-7440</a><br /><a href="mailto:info@novaimpactsolutions.com">info@novaimpactsolutions.com</a></p>
          <p><a href="https://novaimpactsolutions.com" rel="noopener">novaimpactsolutions.com</a> · <a href={`${trial}?utm_source=missed-call-guides&utm_medium=footer`} rel="noopener">NOVA free trial</a></p>
        </div>
      </div>
      <div class="legal">General information, not legal advice. Census figures count establishments with paid employees only. Last site build: {new Date().toISOString().slice(0, 10)}.</div>
    </footer>
  </body>
</html>
