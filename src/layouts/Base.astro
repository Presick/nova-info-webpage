---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description, path, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://example.com').toString();
const fullTitle = path === '/' ? title : `${title} | NOVA AI Receptionist`;
const trial = 'https://30-day.novaimpactsolutions.com/';
const nav = [
  { href: '/#how', label: 'How it works' },
  { href: '/#features', label: 'Features' },
  { href: '/compare', label: 'Compare' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/guides/missed-calls-research', label: 'Guides' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const guideLinks = [
  { href: '/guides/missed-calls-research', label: 'What the missed-call studies say' },
  { href: '/kentucky/plumbing-hvac/missed-calls', label: 'Kentucky plumbing & HVAC' },
  { href: '/kentucky/electrical/missed-calls', label: 'Kentucky electrical' },
  { href: '/kentucky/landscaping-tree/missed-calls', label: 'Kentucky landscaping & tree' },
  { href: '/kentucky/roofing/missed-calls', label: 'Kentucky roofing' },
  { href: '/kentucky/call-rules', label: 'Kentucky call rules' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f2740" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NOVA AI Receptionist" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/">
          <span class="mark" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
          </span>
          <span>NOVA<small>24/7 AI receptionist</small></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          <span>Menu</span>
        </button>
        <nav class="nav" id="site-nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a>)}
          <a class="btn small" href={`${trial}?utm_source=nova-site&utm_medium=nav`} rel="noopener">Start free trial</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <script is:inline>
      (function () {
        var header = document.querySelector('.site-header');
        var btn = header && header.querySelector('.menu-toggle');
        if (!btn) return;
        function set(open) {
          header.toggleAttribute('data-open', open);
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        btn.addEventListener('click', function () { set(!header.hasAttribute('data-open')); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && header.hasAttribute('data-open')) { set(false); btn.focus(); }
        });
        document.addEventListener('click', function (e) {
          if (header.hasAttribute('data-open') && !header.contains(e.target)) set(false);
        });
        header.querySelectorAll('.nav a').forEach(function (a) { a.addEventListener('click', function () { set(false); }); });
        window.matchMedia('(min-width: 1101px)').addEventListener('change', function (m) { if (m.matches) set(false); });
      })();
    </script>

    <footer class="site-footer">
      <div class="cols">
        <div>
          <h2>NOVA</h2>
          <p>A 24/7 AI receptionist for home service businesses, from Nova Impact Solutions. It answers inbound calls before voicemail, books appointments, follows up on estimates and hands urgent calls to a person you choose.</p>
          <p><a class="btn small" href={`${trial}?utm_source=nova-site&utm_medium=footer`} rel="noopener">Start your 30-day free trial</a></p>
        </div>
        <div>
          <h2>Learn more</h2>
          <ul>
            <li><a href="/#how">How it works</a></li>
            <li><a href="/#features">Features</a></li>
            <li><a href="/compare">Compare AI receptionists</a></li>
            <li><a href="/#pricing">Pricing</a></li>
            <li><a href="/about">About and editorial standards</a></li>
          </ul>
        </div>
        <div>
          <h2>Guides</h2>
          <ul>
            {guideLinks.map((g) => <li><a href={g.href}>{g.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>Nova Impact Solutions</h2>
          <p>7659 Mall Road<br />Florence, KY 41042<br /><a href="tel:+18595947440">(859) 594-7440</a><br /><a href="mailto:info@novaimpactsolutions.com">info@novaimpactsolutions.com</a></p>
          <p><a href="https://novaimpactsolutions.com" rel="noopener">novaimpactsolutions.com</a></p>
        </div>
      </div>
      <div class="legal">Nova Impact Solutions publishes this site and sells NOVA. General information, not legal advice. Competitor information is from public vendor and comparison pages and may change. Last site build: {new Date().toISOString().slice(0, 10)}.</div>
    </footer>
  </body>
</html>
